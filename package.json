{
	"name": "ss-attendance",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply ss-attendance --local",
		"db:migrate:remote": "wrangler d1 migrations apply ss-attendance --remote",
		"test": "vitest run --config vitest.config.ts",
		"admin:grant": "node scripts/set-admin-claim.mjs grant",
		"admin:revoke": "node scripts/set-admin-claim.mjs revoke"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "latest",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-router": "latest",
		"@tanstack/react-router-devtools": "latest",
		"@tanstack/react-start": "latest",
		"daisyui": "^5.7.32",
		"drizzle-orm": "^0.45.2",
		"firebase": "^12.19.0",
		"firebase-admin": "^13.8.0",
		"jose": "^6.2.12",
		"lucide-react": "^1.43.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.1.18",
		"zod": "^4.6.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.26.0",
		"@cloudflare/workers-types": "^5.20260910.1",
		"@tailwindcss/typography": "^0.5.16",
		"@tanstack/devtools-vite": "latest",
		"@tanstack/router-cli": "^1.132.0",
		"@types/node": "^22.20.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"drizzle-kit": "^0.31.10",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "^5.0.0",
		"wrangler": "^4.130.0"
	}
}
